# Plantilla de variables de entorno. Copiar a `.env` y completar.
# `.env` está en .gitignore y nunca debe commitearse.

# Origen: branch `dev` de Neon (endpoint directo, sin `-pooler`).
NEON_DEV_DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require

# Destino: Snowflake.
SNOWFLAKE_ACCOUNT=orgname-account
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

SNOWFLAKE_WAREHOUSE=WH_INMOBILIARIA
SNOWFLAKE_DATABASE=INMOBILIARIA_DW
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=INMOBILIARIA_DATAOPS_LOADER
